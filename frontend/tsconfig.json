{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "main.tsx"],
  "exclude": ["node_modules", "dist"]
}
