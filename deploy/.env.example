# CodeBuild에서 선택한 Docker 이미지. 배포 산출물에서 아래 값을 제공한다.
BACKEND_IMAGE=docker.io/example/chongchong-backend
BACKEND_IMAGE_TAG=replace-with-commit-sha

# 외부에 공개할 HTTPS 주소. 임시 nip.io 도메인은 <공인_IP>.nip.io 형식으로 지정한다.
AWS_REGION=ap-northeast-2
SERVER_NAME=203-0-113-10.nip.io
CERTBOT_EMAIL=operator@example.com

# Docker Hub 인증 정보. 필요한 최소 권한만 부여한 토큰을 사용한다.
DOCKERHUB_USERNAME=replace-me
DOCKERHUB_TOKEN=replace-me

# Spring 애플리케이션 설정.
# 파일 업로드용 S3 버킷과 환경별 저장 경로. 경로 끝의 /를 포함한다.
AWS_S3_BUCKET=replace-with-upload-bucket-name
AWS_S3_UPLOAD_PREFIX=example-project/files/example-env/uploads/
# Presigned URL 유효기간. 10m(10분), 1h(1시간)처럼 단위를 포함한다.
AWS_URL_VALIDITY=10m

# 일반 개발·운영 환경에서는 아래 기본값을 유지한다.
# 개발 환경 부하 테스트에서만 load-test 프로필을 추가하고 발송 모드를 simulated로 설정한다.
SPRING_PROFILES_ACTIVE=
WEB_PUSH_SENDER_MODE=real
WEB_PUSH_SENDER_SIMULATED_DELAY_MS=500
WEB_PUSH_DELIVERY_CONCURRENCY=1
WEB_PUSH_DELIVERY_SEND_TIMEOUT=5s
WEB_PUSH_DELIVERY_SHUTDOWN_TIMEOUT=8s
# Spring 종료 단계와 발송 완료 대기를 포함한 컨테이너 종료 제한 시간.
BACKEND_STOP_TIMEOUT_SECONDS=60
DB_URL=jdbc:postgresql://database.example:5432/chongchong
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

STUDY_INVITE_JWT_SECRET=replace-me

FRONTEND_BASE_URL=https://frontend.example
# 선택 설정: 허용할 브라우저 출처를 정확히 지정하고 쉼표로 구분한다. 기본값은 FRONTEND_BASE_URL이다.
# 인증 정보를 포함하는 CORS 요청에는 와일드카드를 사용하지 않는다.
FRONTEND_ALLOWED_ORIGINS=https://frontend.example

AUTH_JWT_ISSUER=chongchong
AUTH_JWT_AUDIENCE=chongchong-client
AUTH_JWT_SECRET_BASE64=replace-me
AUTH_JWT_ACCESS_TOKEN_VALIDITY=30m
AUTH_REFRESH_TOKEN_VALIDITY=30d
AUTH_KAKAO_REST_API_KEY=replace-me
AUTH_KAKAO_CLIENT_SECRET=replace-me
AUTH_KAKAO_REDIRECT_URI=https://frontend.example/auth/kakao/callback

WEB_PUSH_VAPID_PUBLIC_KEY=replace-me
WEB_PUSH_VAPID_PRIVATE_KEY=replace-me
WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.com
WEB_PUSH_NOTIFICATION_CLICK_TOKEN_SECRET=replace-with-base64-encoded-32-byte-secret

CLOUD_WATCH_APP_ENV=prod
CLOUD_WATCH_AWS_REGION=ap-northeast-2
METRICS_SCRAPE_INTERVAL=60s
METRICS_SCRAPE_TIMEOUT=10s

# 개발 환경 배포에서는 수집기를 자동으로 재생성한다. 운영 환경은 명시적으로 활성화해야 한다.
# COMPOSE_PROFILES=metrics

# 개발 환경 전용 알림 부하 테스트: 위의 해당 설정값을 아래 값으로 변경한다.
# 다른 필수 활성 프로필은 유지한다. 운영 환경에서는 시뮬레이터를 활성화하지 않는다.
# CLOUD_WATCH_APP_ENV=dev
# SPRING_PROFILES_ACTIVE=load-test
# WEB_PUSH_SENDER_MODE=simulated
# WEB_PUSH_SENDER_SIMULATED_DELAY_MS=500
