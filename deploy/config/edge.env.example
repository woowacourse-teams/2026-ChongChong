# /opt/chongchong/config/edge.env — root:root 600, 실제 주소로 변경한다.
# 2026-11-05 dev AL2023 예시. prod와 재생성 서버는 실제 주소로 바꾼다.
BACKEND_A_HOST=10.0.0.77
BACKEND_B_HOST=10.0.0.38
SSH_USER=ec2-user
SSH_KEY=/root/.ssh/chongchong-deploy
SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
SERVER_NAME=chongchong-dev-43-200-22-229.nip.io
CLOUD_WATCH_APP_ENV=dev
CLOUD_WATCH_AWS_REGION=ap-northeast-2
NGINX_API_LOG_FORMAT=loadtest
EDGE_DEPLOYMENT_RETENTION_COUNT=3
# failover 상태를 bootstrap한 경우에만 사용한다. 감시 간격은 systemd timer에서 정한다.
EDGE_FAILURE_THRESHOLD=3
EDGE_SUCCESS_THRESHOLD=3
EDGE_SOAK_SECONDS=600
